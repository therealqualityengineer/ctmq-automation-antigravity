{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "QA-SDLC Live: Start Dashboard Server (:5174)",
      "type": "shell",
      "command": "npm run dashboard",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "QA-SDLC Live Dashboard running",
          "endsPattern": "Real-time SSE Telemetry Stream"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "qa-sdlc"
      }
    },
    {
      "label": "QA-SDLC Live: Open in VS Code Simple Browser",
      "dependsOn": [
        "QA-SDLC Live: Start Dashboard Server (:5174)"
      ],
      "command": "${input:openSimpleBrowser}",
      "presentation": {
        "reveal": "never"
      }
    }
  ],
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://127.0.0.1:5174"
    }
  ]
}
